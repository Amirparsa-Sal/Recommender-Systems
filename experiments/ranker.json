{
  "data_dir": "data",
  "cache_dir": "cache",
  "validation_fraction": 0.2,
  "split_mode": "global",
  "split_seed": 42,
  "cutoffs": [20],
  "out_dir": "results/ranker",
  "folds": 4,
  "components": [
    {"model": "item_knn", "label": "item_knn", "params": {"similarity": "cosine", "topk": 100, "shrink": 10}},
    {"model": "user_knn", "label": "user_knn", "params": {"similarity": "cosine", "topk": 200, "shrink": 10}},
    {"model": "rp3beta", "label": "rp3beta"},
    {"model": "gfcf", "label": "gfcf", "params": {"n_factors": 512, "user_exponent": 0.4, "item_exponent": 0.4}}
  ],
  "ranker": {
    "candidates": 50,
    "objective": "binary:logistic",
    "max_depth": 6,
    "learning_rate": 0.05
  }
}
