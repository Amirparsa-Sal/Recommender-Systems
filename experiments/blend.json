{
  "data_dir": "data",
  "validation_fraction": 0.2,
  "split_mode": "global",
  "split_seed": 42,
  "cutoffs": [20],
  "sort_by": "ndcg@20",
  "models": [
    {
      "model": "hybrid_linear",
      "label": "blend",
      "params": {
        "normalize": "max",
        "cache_dir": "cache",
        "components": [
          {"model": "slim_elasticnet", "params": {"alpha": 0.002, "max_iter": 1000, "tol": 0.001, "l1_ratio": 0.005, "topk": 500}},
          {"model": "user_knn", "params": {"similarity": "cosine", "topk": 80, "shrink": 10}},
          {"model": "item_knn", "params": {"similarity": "cosine", "topk": 90, "shrink": 100}},
          {"model": "slim_bpr", "params": {"epochs": 3, "lr": 0.1, "lambda_pos": 0.01, "lambda_neg": 0.01, "batch_size": 1024, "topk": 500}},
          {"model": "rwr", "params": {"damping": 0.2, "iterations": 10}}
        ]
      },
      "grid": {
        "weights": [
          [1, 0, 0, 0, 0],
          [1, 0.5, 0, 0, 0],
          [1, 0, 0.5, 0, 0],
          [1, 0, 0, 0.5, 0],
          [1, 0, 0, 0, 0.5],
          [1, 0.5, 0.5, 0.5, 0.5],
          [1, 0.5, 0.25, 0.25, 0.5]
        ]
      }
    }
  ]
}